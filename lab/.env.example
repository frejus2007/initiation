# ==============================================================================
# PIGHACK — Atelier IA : configuration du service de laboratoire
# Copiez ce fichier en `.env` puis ajustez les valeurs.
# ==============================================================================

# --- Écoute locale uniquement (jamais exposé sur Internet) ---
LAB_HOST=127.0.0.1
LAB_PORT=8090

# Origines autorisées (CORS). En maquette : "*" pour file:// et serveurs locaux.
LAB_ALLOWED_ORIGINS=*

# Durée de vie d'une session de chat (secondes). Défaut : 1 h.
LAB_SESSION_TTL=3600

# --- Supabase (optionnel) -----------------------------------------------------
# Si renseigné, le lab crédite automatiquement les points quand l'étudiant
# soumet un flag correct (RPC `lab_submit_flag` via la clé service_role).
# Laissez vide pour un lancement 100 % hors ligne (validation locale seule).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Clé anon publique (utilisée seulement si l'on relaie un access_token étudiant).
SUPABASE_ANON_KEY=
